# Backend API base URL — the FastAPI app (AI-travel-planning-agent-be).
# Local dev: run `uvicorn main:app` in the backend repo, defaults to this.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional — only needed once the backend's API_KEY env var is configured.
# When set, sent as the X-API-Key header on every request.
NEXT_PUBLIC_API_KEY=
